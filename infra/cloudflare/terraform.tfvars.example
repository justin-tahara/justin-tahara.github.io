# Copy this file to terraform.tfvars and fill in your zone id.
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored and must NEVER be committed.
# (zone_id isn't strictly secret, but keeping real values out of git is good hygiene.)

zone_id = "your-cloudflare-zone-id-here"

# The following already have sensible defaults in variables.tf — override only if they change:
# domain             = "justintahara.com"
# github_pages_cname = "justin-tahara.github.io"
